# Copy to backend/.env and adjust. Every setting has a safe local default.
DATAHUB_ENVIRONMENT=development           # development | test | production
DATAHUB_DATABASE_URL=sqlite:///data/datahub.db
DATAHUB_SEED_DEMO_DATA=true

# Sign-in directory: "yaml" (a local stand-in, see ldap-directory.yaml) or "ldap" (a real server)
DATAHUB_DIRECTORY=yaml
DATAHUB_LDAP_DIRECTORY_FILE=ldap-directory.yaml

# For DATAHUB_DIRECTORY=ldap (Active Directory example). Sign-in binds as the person with their own
# LAN ID and password, then reads their entry. Use ldaps:// (or START_TLS=true) outside development.
#DATAHUB_LDAP_SERVER_URL=ldaps://ad.corp.example.com
#DATAHUB_LDAP_START_TLS=false
#DATAHUB_LDAP_CA_CERTS_FILE=/etc/pki/tls/certs/corp-ca.pem
#DATAHUB_LDAP_BIND_FORMAT={lan_id}@corp.example.com
#DATAHUB_LDAP_SEARCH_BASE=DC=corp,DC=example,DC=com
#DATAHUB_LDAP_SEARCH_FILTER=(sAMAccountName={lan_id})
#DATAHUB_LDAP_TIMEOUT_SECONDS=5
#DATAHUB_LDAP_ATTRIBUTE_DISPLAY_NAME=displayName
#DATAHUB_LDAP_ATTRIBUTE_EMAIL=mail
#DATAHUB_LDAP_ATTRIBUTE_DEPARTMENT=department
#DATAHUB_LDAP_ATTRIBUTE_TITLE=title

# LAN IDs made system admins when they sign in (how the first system admin gets in)
DATAHUB_BOOTSTRAP_SYSTEM_ADMINS=["admin"]

# Required in production: a random value of at least 32 characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DATAHUB_JWT_SECRET=change-me
DATAHUB_ACCESS_TOKEN_MINUTES=60

DATAHUB_CORS_ORIGINS=["http://localhost:5173"]
